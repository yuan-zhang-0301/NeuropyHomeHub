async def handle_close(websocket_handler):
    """Ensures WebSocket cleanup and turns off the LED properly."""
    await websocket_handler.on_close()  # Properly await the function
    turn_led_off()  # Turn off the LED

async def process_hume_results(websocket_handler):
    """
    Processes the Hume results after capturing voice data.
    Extracts transcript, analyzes emotions with ChatGPT, and saves to Firebase.
    """
    if not websocket_handler.messages:
        print("⚠️ No messages captured from Hume!")
        return

    # ✅ Extract the full transcript (all user messages)
    transcript = " ".join([
        msg["message"] for msg in websocket_handler.messages if msg["role"] == "USER"
    ])
    
    # ✅ Aggregate top 3 emotions detected by Hume
    all_emotions = {}
    for msg in websocket_handler.messages:
        if msg["role"] == "USER" and msg["emotions"]:
            for emotion, score in msg["emotions"].items():
                all_emotions[emotion] = max(score, all_emotions.get(emotion, 0))
    
    # ✅ Get the top 3 emotions overall
    top_emotions = dict(sorted(
        all_emotions.items(),
        key=lambda x: x[1],
        reverse=True
    )[:3])

    # ✅ Debugging Output
    print("\n=== Hume Transcript ===")
    print(transcript)
    print("\n=== Hume Detected Emotions ===")
    print(top_emotions)

    # ✅ Send to ChatGPT for further analysis
    emotional_analysis, empathetic_feedback = analyze_sentiment_with_chatgpt(transcript, top_emotions)
    chatgpt_output = extract_emotion_associations(transcript, top_emotions)  # ✅ Structured text, NOT JSON
    associations = parse_chatgpt_output(chatgpt_output)

    # ✅ Debugging Output
    print("\n=== ChatGPT Emotional Analysis ===")
    print(emotional_analysis)
    print("\n=== ChatGPT Empathetic Feedback ===")
    print(empathetic_feedback)
    print("\n=== Parsed Emotion Associations ===")
    print(associations)

    # ✅ Save to Firebase
    chat_id = websocket_handler.chat_id if websocket_handler.chat_id else "unknown_chat"
    save_chat_to_firestore(chat_id, emotional_analysis, empathetic_feedback, associations)

async def main():
    """Main function that integrates Hume for real-time voice emotion analysis."""
    turn_led_on()  # ✅ LED turns on when script starts

    # ✅ Load API keys
    HUME_API_KEY, HUME_SECRET_KEY, HUME_CONFIG_ID = get_env_variables()

    # ✅ Initialize Hume API Client
    client = AsyncHumeClient(api_key=HUME_API_KEY)
    options = ChatConnectOptions(config_id=HUME_CONFIG_ID, secret_key=HUME_SECRET_KEY)

    # ✅ Initialize WebSocket Handler
    websocket_handler = WebSocketHandler()

    async with client.empathic_voice.chat.connect_with_callbacks(
        options=options,
        on_open=websocket_handler.on_open,
        on_message=websocket_handler.on_message,
        on_close=lambda: asyncio.create_task(handle_close(websocket_handler)),  # Properly await cleanup
        on_error=websocket_handler.on_error
    ) as socket:
        websocket_handler.set_socket(socket)

        try:
            # ✅ Start microphone streaming (real-time voice emotion analysis)
            print("Starting microphone streaming...")
            microphone_task = asyncio.create_task(
                MicrophoneInterface.start(
                    socket,
                    device=sd.default.device,  # Uses selected mic
                    allow_user_interrupt=False,
                    byte_stream=websocket_handler.byte_strs
                )
            )
            
            # ✅ Start message handling task
            message_sending_task = asyncio.create_task(sending_handler(socket))

            # ✅ Run both tasks together
            await asyncio.gather(microphone_task, message_sending_task)

        except websockets.exceptions.ConnectionClosedOK:
            print("Chat session ended normally.")

        except Exception as e:
            print(f"An error occurred: {e}")

    # ✅ Process Hume results **after** session ends
    await process_hume_results(websocket_handler)

if __name__ == "__main__":
    print("Waiting for button press to start...")
    asyncio.run(main())  # ✅ Script starts when button is pressed



