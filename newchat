def analyze_sentiment_with_chatgpt(transcript, top_emotions):
    """Analyze emotional state and provide empathetic feedback using ChatGPT."""
    emotions_str = ", ".join([f"{emotion} ({score:.2f})" for emotion, score in top_emotions.items()])
    
    prompt = f"""Analyze the emotional state and sentiment of this person in two distinct parts.
Hume's voice analysis detected these top emotions: {emotions_str}

### Part 1 - Emotional Analysis (max 3 sentences)
Start with "Hey there, it sounds like you're feeling..." and describe:
- Their current emotional state
- Direct causes of these emotions
- Specific situations they mentioned
- Keep it purely descriptive without interpretation

### Part 2 - Empathetic Response (2-3 sentences)
- Provide brief validation
- Offer gentle support
- Keep it concise and warm

Transcript:
{transcript}

Return the two parts separated by |||"""

    response = openai.ChatCompletion.create(
        model="gpt-3.5-turbo",
        messages=[{"role": "user", "content": prompt}],
        max_tokens=300,
        temperature=0
    )
    
    analysis, feedback = response["choices"][0]["message"]["content"].split("|||")
    return analysis.strip(), feedback.strip()

def extract_emotion_associations(transcript, top_emotions):
    """Extract associations for each detected emotion using ChatGPT."""
    emotions_str = ", ".join([f"{emotion} ({score:.2f})" for emotion, score in top_emotions.items()])

    prompt = f"""Analyze associations for each detected emotion in the transcript.
    Output the information as a structured text format (NOT JSON), with clear labels.
    
    Emotions detected: {emotions_str}

    For each emotion, provide:
    - **Expressed Intensity**: Low / Medium / High
    - **Associated People**: Who causes this emotion (list up to 3, "None" if not found)
    - **Associated Locations**: Where this emotion was expressed (list up to 3, "None" if not found)
    - **Associated Events**: What events triggered this emotion (list up to 3, "None" if not found)
    - **Associated Environment**: Surrounding conditions (weather, light, temperature) that cause this emotion (list up to 3, "None" if not found)
    - **Associated Health**: Health-related elements that cause this emotion (list up to 3, "None" if not found)

    **Format the response like this:**
    
    Emotion: [Emotion Name]
    Expressed Intensity: [Low / Medium / High]
    Associated People: [Person 1, Person 2, Person 3] OR "None"
    Associated Locations: [Location 1, Location 2, Location 3] OR "None"
    Associated Events: [Event 1, Event 2, Event 3] OR "None"
    Associated Environment: [Condition 1, Condition 2, Condition 3] OR "None"
    Associated Health: [Health Factor 1, Health Factor 2, Health Factor 3] OR "None"

    Transcript:
    {transcript}
    """

    response = openai.ChatCompletion.create(
        model="gpt-3.5-turbo",
        messages=[{"role": "user", "content": prompt}],
        max_tokens=500,
        temperature=0
    )

    return response["choices"][0]["message"]["content"]


def parse_chatgpt_output(text_output):
    """Parses structured text output from ChatGPT into JSON format."""
    emotion_data = {}  # Store emotions and their associated data

    # Regular expression to detect each emotion section
    emotion_sections = re.split(r'\nEmotion: ', text_output.strip())

    for section in emotion_sections:
        if not section.strip():
            continue

        lines = section.split("\n")
        emotion_name = lines[0].strip()  # First line should be the emotion name

        # ✅ Remove "Emotion: " prefix if present
        emotion_name = emotion_name.replace("Emotion: ", "").strip()

        # Initialize storage for each emotion
        emotion_data[emotion_name] = {
            "expressed_intensity": None,
            "associated_people": [],
            "associated_locations": [],
            "associated_events": [],
            "associated_environment": [],
            "associated_health": []
        }

        # Process each line
        for line in lines[1:]:
            line = line.strip()
            if line.startswith("Expressed Intensity:"):
                emotion_data[emotion_name]["expressed_intensity"] = line.split(":")[1].strip()
            elif line.startswith("Associated People:"):
                people = line.split(":")[1].strip()
                emotion_data[emotion_name]["associated_people"] = people.split(", ") if people != "None" else []
            elif line.startswith("Associated Locations:"):
                locations = line.split(":")[1].strip()
                emotion_data[emotion_name]["associated_locations"] = locations.split(", ") if locations != "None" else []
            elif line.startswith("Associated Events:"):
                events = line.split(":")[1].strip()
                emotion_data[emotion_name]["associated_events"] = events.split(", ") if events != "None" else []
            elif line.startswith("Associated Environment:"):
                environment = line.split(":")[1].strip()
                emotion_data[emotion_name]["associated_environment"] = environment.split(", ") if environment != "None" else []
            elif line.startswith("Associated Health:"):
                health = line.split(":")[1].strip()
                emotion_data[emotion_name]["associated_health"] = health.split(", ") if health != "None" else []

    return emotion_data



def analyze_transcript_with_chatgpt(transcript, top_emotions):
    """Main function to analyze the transcript using ChatGPT."""
    print("\n--- Full Transcript ---")
    print(transcript)
    
    print("\n--- Top 3 Emotions Detected ---")
    for emotion, score in top_emotions.items():
        print(f"{emotion}: {score:.2f}")

    try:
        # Get Emotional Analysis & Empathetic Feedback
        emotional_analysis, empathetic_feedback = analyze_sentiment_with_chatgpt(transcript, top_emotions)
        print("\n--- Emotional Analysis ---")
        print(emotional_analysis)
        
        print("\n--- Empathetic Feedback ---")
        print(empathetic_feedback)
    except Exception as e:
        print(f"Error in emotional analysis: {e}")
        emotional_analysis, empathetic_feedback = "", ""

    try:
        # Extract Entities and Emotion Associations
        associations = extract_emotion_associations(transcript, top_emotions)
        print("\n--- Emotion Associations ---")
        print(associations)
    except Exception as e:
        print(f"Error in extracting associations: {e}")
        associations = ""

    return emotional_analysis, empathetic_feedback, associations

